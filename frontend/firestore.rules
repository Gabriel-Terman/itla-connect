rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Colección "usuarios"
    match /usuarios/{userId} {
      // Cualquiera puede leer perfiles básicos (para mostrar autor en el feed)
      allow read: if true;
      // Solo el propio usuario puede crear o editar su documento
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Colección "publicaciones"
    match /publicaciones/{postId} {
      // Lectura pública: se puede ver el feed sin iniciar sesión
      allow read: if true;

      // Solo usuarios autenticados pueden crear, y deben crearla a su propio nombre
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;

      // Solo el autor puede editar o eliminar su propia publicación
      allow update, delete: if request.auth != null
                             && resource.data.authorId == request.auth.uid;
    }
  }
}
